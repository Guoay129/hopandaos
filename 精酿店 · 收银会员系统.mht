      <div class="card-title">今日营收明细</div>
      <div id="todayDetail"></div>
    </div>
    <div class="card">
      <div class="card-title">会员等级分布</div>
      <div id="levelStats"></div>
    </div>
    <div class="card">
      <div class="card-title">酒款销量排行</div>
      <div id="beerRanking"></div>
    </div>
    <div class="card">
      <div class="card-title">会员消费排行 TOP5</div>
      <div id="memberRanking"></div>
    </div>
    <div class="card">
      <div class="card-title">📊 数据导出</div>
      <p style="font-size:12px;color:var(--text-light);margin-bottom:12px;">导出数据为 CSV 文件，可用 Excel / WPS 打开</p>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
        <button class="btn btn-outline btn-block">👤 客户信息</button>
        <button class="btn btn-outline btn-block">🧾 消费记录</button>
        <button class="btn btn-outline btn-block">🍺 商品信息</button>
        <button class="btn btn-outline btn-block">📋 销售记录</button>
      </div>
      <p style="font-size:12px;color:var(--text-light);margin-bottom:4px;margin-top:14px;">JSON 格式用于跨设备数据同步</p>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
        <button class="btn btn-primary btn-block">📦 导出全部数据</button>
        <button class="btn btn-outline btn-block">📥 导入数据</button>
      </div>
    </div>
  </div>

</div>

<!-- ===== MODALS ===== -->

<!-- Table Action Modal (open table / view order) -->
<div class="modal-overlay" id="tableModal">
  <div class="modal">
    <div class="modal-header">
      <h2 id="tableModalTitle">桌位操作</h2>
      <button class="modal-close">✕</button>
    </div>
    <div id="tableModalContent"></div>
  </div>
</div>

<!-- New Order Modal -->
<div class="modal-overlay" id="orderModal">
  <div class="modal">
    <div class="modal-header">
      <h2 id="orderModalTitle">新建订单</h2>
      <button class="modal-close">✕</button>
    </div>
    <div id="orderModalContent"></div>
  </div>
</div>

<!-- Add Item Modal -->
<div class="modal-overlay" id="addItemModal">
  <div class="modal">
    <div class="modal-header">
      <h2>添加酒款</h2>
      <button class="modal-close">✕</button>
    </div>
    <div id="addItemContent"></div>
  </div>
</div>

<!-- Settle Modal -->
<div class="modal-overlay" id="settleModal">
  <div class="modal">
    <div class="modal-header">
      <h2>结账</h2>
      <button class="modal-close">✕</button>
    </div>
    <div id="settleContent"></div>
  </div>
</div>

<!-- Add/Edit Member Modal -->
<div class="modal-overlay" id="memberModal">
  <div class="modal">
    <div class="modal-header">
      <h2 id="memberModalTitle">新增会员</h2>
      <button class="modal-close">✕</button>
    </div>
    
    <div class="form-row">
      <div class="form-group"><label>姓名 *</label><input type="text" id="mName" placeholder="会员姓名"></div>
      <div class="form-group"><label>手机号 *</label><input type="tel" id="mPhone" placeholder="手机号码"></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label>性别</label><select id="mGender"><option value="男">男</option><option value="女">女</option></select></div>
      <div class="form-group"><label>生日</label><input type="date" id="mBirthday"></div>
    </div>
    <div class="form-group"><label>备注</label><textarea id="mNote" rows="2" placeholder="备注信息"></textarea></div>
    <div class="btn-group">
      <button class="btn btn-outline btn-block">取消</button>
      <button class="btn btn-primary btn-block">保存</button>
    </div>
  </div>
</div>

<!-- Member Detail Modal -->
<div class="modal-overlay" id="memberDetailModal">
  <div class="modal">
    <div class="modal-header">
      <h2>会员详情</h2>
      <button class="modal-close">✕</button>
    </div>
    <div id="memberDetailContent"></div>
  </div>
</div>

<!-- Recharge Modal -->
<div class="modal-overlay" id="rechargeModal">
  <div class="modal">
    <div class="modal-header">
      <h2>会员充值</h2>
      <button class="modal-close">✕</button>
    </div>
    <div class="form-group"><label>选择会员 *</label><select id="rMemberId"></select></div>
    <div class="form-row">
      <div class="form-group"><label>充值金额 *</label><input type="number" id="rAmount" placeholder="充值金额"></div>
      <div class="form-group"><label>赠送金额</label><input type="number" id="rBonus" placeholder="赠送金额" value="0"></div>
    </div>
    <div class="form-group"><label>支付方式</label>
      <select id="rPayMethod"><option value="微信">微信</option><option value="支付宝">支付宝</option><option value="银行卡">银行卡</option><option value="现金">现金</option></select>
    </div>
    <div class="form-group"><label>备注</label><input type="text" id="rNote" placeholder="备注"></div>
    <div class="btn-group">
      <button class="btn btn-outline btn-block">取消</button>
      <button class="btn btn-primary btn-block">确认充值</button>
    </div>
  </div>
</div>

<!-- Beer Modal -->
<div class="modal-overlay" id="beerModal">
  <div class="modal">
    <div class="modal-header">
      <h2 id="beerModalTitle">新增酒款</h2>
      <button class="modal-close">✕</button>
    </div>
    
    <div class="form-row">
      <div class="form-group"><label>酒款名称 *</label><input type="text" id="bName" placeholder="酒款名称"></div>
      <div class="form-group"><label>品类 *</label><select id="bType"></select></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label>风格</label><input type="text" id="bStyle" placeholder="如 IPA、世涛、小麦"></div>
      <div class="form-group"><label>产地</label><input type="text" id="bOrigin" placeholder="产地"></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label>酒精度 (%)</label><input type="number" id="bAbv" step="0.1" placeholder="5.0"></div>
      <div class="form-group"><label>售价 (元)</label><input type="number" id="bPrice" placeholder="售价"></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label>酒头编号</label><input type="text" id="bTap" placeholder="生啤填编号，瓶啤留空"></div>
      <div class="form-group"><label>状态</label><select id="bStatus"><option value="在售">在售</option><option value="缺货">缺货</option><option value="下架">下架</option></select></div>
    </div>
    <div class="form-group" style="margin-bottom:12px"><label>规格/大小杯 <span style="font-weight:400;font-size:11px;color:var(--text-muted)">· 留空则统一售价</span></label><div style="display:flex;gap:8px"><div style="flex:1;display:flex;gap:6px"><input type="text" id="bSize1Name" placeholder="规格名" style="flex:1"><input type="number" id="bSize1Price" placeholder="价格" style="width:72px"></div><div style="flex:1;display:flex;gap:6px"><input type="text" id="bSize2Name" placeholder="规格名" style="flex:1"><input type="number" id="bSize2Price" placeholder="价格" style="width:72px"></div></div></div>
    <div class="form-group" style="margin-bottom:0"><label>备注</label><input type="text" id="bNote" placeholder="备注信息"></div>
    <div class="btn-group">
      <button class="btn btn-outline btn-block">取消</button>
      <button class="btn btn-primary btn-block">保存</button>
    </div>
  </div>
</div>

<!-- Order History Modal -->
<div class="modal-overlay" id="orderHistoryModal">
  <div class="modal">
    <div class="modal-header">
      <h2>订单记录</h2>
      <button class="modal-close">✕</button>
    </div>
    <div id="orderHistoryContent"></div>
  </div>
</div>

<!-- Add/Edit Table Modal -->
<div class="modal-overlay" id="tableEditModal">
  <div class="modal">
    <div class="modal-header">
      <h2 id="tableEditTitle">新增桌位</h2>
      <button class="modal-close">✕</button>
    </div>
    
    <div class="form-group">
      <label>桌位名称 *</label>
      <input type="text" id="teName" placeholder="如：六号桌、包间A">
    </div>
    <div class="form-group">
      <label>座位数 *</label>
      <input type="number" id="teSeats" placeholder="座位数" min="1" value="4">
    </div>
    <div class="btn-group">
      <button class="btn btn-outline btn-block">取消</button>
      <button class="btn btn-primary btn-block">保存</button>
    </div>
  </div>
</div>

<!-- Category Modal -->
<div class="modal-overlay" id="categoryModal">
  <div class="modal">
    <div class="modal-header">
      <h2 id="categoryModalTitle">新增品类</h2>
      <button class="modal-close">✕</button>
    </div>
    
    <div class="form-group">
      <label>品类名称 *</label>
      <input type="text" id="catName" placeholder="如：生啤、瓶啤、小吃、周边">
    </div>
    <div class="form-group">
      <label>图标（emoji）</label>
      <input type="text" id="catIcon" placeholder="如 🍺 🍻 🥨 🎁" maxlength="4">
    </div>
    <div class="btn-group">
      <button class="btn btn-outline btn-block">取消</button>
      <button class="btn btn-primary btn-block">保存</button>
    </div>
  </div>
</div>







</body></html>
