<div class="confirm-overlay" id="confirmOverlay">
  <div class="confirm-box">
    <p id="confirmMsg">确认操作？</p>
    <div class="btn-group">
      <button class="btn btn-outline btn-sm">取消</button>
      <button class="btn btn-primary btn-sm">确认</button>
    </div>
  </div>
</div>

<div class="content">

  <!-- ===== HOME ===== -->
  <div class="page active" id="page-home">
    <div class="kpi-grid" id="homeKpi">
    <div class="kpi-card"><div class="kpi-label">今日营收</div><div class="kpi-value">¥0.00</div><div class="kpi-label">元</div></div>
    <div class="kpi-card"><div class="kpi-label">今日订单</div><div class="kpi-value">0</div><div class="kpi-label">单</div></div>
    <div class="kpi-card"><div class="kpi-label">会员总数</div><div class="kpi-value">0</div><div class="kpi-label">人</div></div>
    <div class="kpi-card"><div class="kpi-label">空闲桌位</div><div class="kpi-value">5/5</div><div class="kpi-label">桌</div></div>
  </div>
    <div class="card">
      <div class="card-title">桌位状态</div>
      <div class="table-strip" id="homeTableStrip">
    <div class="table-chip free">
      一号桌吧台 🟢
    </div>
  
    <div class="table-chip free">
      二号桌 🟢
    </div>
  
    <div class="table-chip free">
      三号桌 🟢
    </div>
  
    <div class="table-chip free">
      四号桌 🟢
    </div>
  
    <div class="table-chip free">
      五号桌 🟢
    </div>
  </div>
    </div>
    <div class="quick-actions">
      <button class="quick-action">
        <span class="icon">🪑</span><span class="label">桌位管理</span>
      </button>
      <button class="quick-action">
        <span class="icon">👤</span><span class="label">新增会员</span>
      </button>
      <button class="quick-action">
        <span class="icon">💰</span><span class="label">会员充值</span>
      </button>
    </div>
    <div class="card">
      <div class="card-title">最近订单</div>
      <div id="recentOrders"><div class="empty-state"><p>暂无订单</p></div></div>
    </div>
    <div class="card">
      <div class="card-title">最近充值</div>
      <div id="recentRecharges"><div class="empty-state"><p>暂无充值记录</p></div></div>
    </div>
  </div>

  <!-- ===== TABLES ===== -->
  <div class="page" id="page-tables">
    <div class="kpi-grid" id="tableKpi"></div>
    <div style="display:flex;gap:8px;margin-bottom:14px;">
      <button class="btn btn-primary" style="flex:1;">+ 新增桌位</button>
    </div>
    <div class="table-grid" id="tableGrid"></div>
  </div>

  <!-- ===== MEMBERS ===== -->
  <div class="page" id="page-members">
    <div class="search-bar">
      <input type="text" id="memberSearch" placeholder="搜索姓名/手机号">
      <button class="btn btn-primary">+ 新增</button>
    </div>
    <div id="memberList"></div>
  </div>

  <!-- ===== RECHARGE ===== -->
  <div class="page" id="page-recharge">
    <div class="search-bar">
      <input type="text" id="rechargeSearch" placeholder="搜索会员姓名/手机号">
      <button class="btn btn-primary">+ 充值</button>
    </div>
    <div id="rechargeList"></div>
  </div>

  <!-- ===== BEERS ===== -->
  <div class="page" id="page-beers">
    <div style="display:flex;gap:8px;margin-bottom:12px;">
      <button class="btn btn-primary" style="flex:1;">+ 新增品类</button>
      <button class="btn btn-primary" style="flex:1;">+ 新增酒款</button>
    </div>
    <div class="search-bar">
      <input type="text" id="beerSearch" placeholder="搜索酒款名称">
    </div>
    <div id="beerList"></div>
  </div>

  <!-- ===== STATS ===== -->
  <div class="page" id="page-stats">
    <div class="kpi-grid" id="statsKpi"></div>
