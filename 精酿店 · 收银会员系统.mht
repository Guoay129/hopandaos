.record-amount { font-size: 14px; font-weight: 600; white-space: nowrap; }

.record-amount.income { color: var(--green); }

.record-amount.expense { color: var(--red); }

.beer-card { padding: 14px; margin-bottom: 8px; }

.beer-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; }

.beer-name { font-size: 14px; font-weight: 600; }

.beer-price { font-size: 14px; font-weight: 700; color: var(--accent); }

.beer-meta { display: flex; gap: 12px; font-size: 11px; color: var(--text-muted); }

.member-card { padding: 16px; margin-bottom: 8px; cursor: pointer; }

.member-info h4 { font-size: 14px; font-weight: 600; }

.member-info p { font-size: 12px; color: var(--text-muted); margin-top: 2px; }

.member-balance { font-size: 14px; font-weight: 700; }

.detail-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 0px; border-bottom: 1px solid var(--border-light); }

.detail-row:last-child { border-bottom-width: medium; border-bottom-style: none; border-bottom-color: currentcolor; }

.detail-label { font-size: 13px; color: var(--text-muted); }

