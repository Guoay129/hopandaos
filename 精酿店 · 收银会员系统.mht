.card, .modal, .kpi-card, .table-card, .member-card, .beer-card { background: var(--card); border: 1px solid var(--border-light); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); transition: all var(--transition); }

.card { padding: 20px; margin-bottom: 12px; }

