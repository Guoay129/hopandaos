.badge-amber { background: var(--amber-soft); color: var(--amber); }

.badge-red { background: var(--red-soft); color: var(--red); }

.modal-overlay { display: none; position: fixed; inset: 0px; background: rgba(0, 0, 0, 0.4); z-index: 1000; align-items: flex-end; justify-content: center; }

